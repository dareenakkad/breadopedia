---
const { current = '' } = Astro.props as { current?: string };
const nav = [
  ['Breads', '/breads'],
  ['Classes', '/classes'],
  ['Countries', '/countries'],
  ['Articles', '/articles'],
];
---
<header class="masthead">
  <a class="skip t-ui" href="#main">Skip to content</a>
  <div class="strip">
    <div class="wrap strip-in">
      <span class="t-caption strip-text">Every bread on earth.</span>
      <nav class="strip-links t-caption" aria-label="Site">
        <a href="/about">About</a>
        <a href="/articles">Articles</a>
      </nav>
    </div>
  </div>
  <div class="wrap brand">
    <a class="t-wordmark wordmark" href="/">Breadopedia</a>
    <form class="search" action="/search" role="search">
      <label class="visually-hidden" for="q">Search</label>
      <input class="t-ui" id="q" name="q" type="search" placeholder="Search every bread" autocomplete="off" />
      <button class="t-ui" type="submit">Search</button>
    </form>
  </div>
  <div class="wrap">
    <nav class="nav" aria-label="Primary">
      <button class="t-ui menu" aria-expanded="false" aria-controls="primary-nav">Menu</button>
      <ul id="primary-nav" class="t-nav">
        {nav.map(([label, href]) => (
          <li><a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .skip { position: absolute; left: var(--space-4); top: -100px; background: var(--cobalt); color: var(--paper); padding: 6px 12px; z-index: 10; }
  .skip:focus { top: 6px; }
  .strip { background: var(--cobalt); color: var(--paper); height: 34px; }
  .strip-in { display: flex; justify-content: space-between; align-items: center; height: 34px; }
  .strip-text { color: var(--paper); }
  .strip-links { display: none; gap: var(--space-6); }
  .strip-links a { color: var(--paper); text-decoration: none; }
  .strip-links a:hover { text-decoration: underline; }
  .brand { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); padding-top: var(--space-4); padding-bottom: var(--space-4); flex-wrap: wrap; }
  .wordmark { color: var(--ink); text-decoration: none; }
  .search { display: flex; border: var(--rule-frame) solid var(--ink); height: 40px; flex: 1 1 100%; max-width: 420px; }
  .search input { flex: 1; border: 0; padding: 0 var(--space-3); background: var(--paper); min-width: 0; }
  .search input::placeholder { color: var(--slate); }
  .search input:focus-visible { outline-offset: -3px; }
  .search button { border: 0; border-left: var(--rule-frame) solid var(--ink); background: var(--paper); padding: 0 var(--space-4); cursor: pointer; transition: background 120ms, color 120ms; }
  .search button:hover { background: var(--ink); color: var(--paper); }
  .nav { border-top: var(--rule-section) solid var(--ink); border-bottom: 1px solid var(--ink); }
  .menu { display: block; margin: var(--space-2) 0; background: var(--paper); border: var(--rule-frame) solid var(--ink); padding: 6px 12px; cursor: pointer; }
  .nav ul { list-style: none; margin: 0; padding: 0; display: none; flex-direction: column; }
  .nav ul.open { display: flex; }
  .nav li a { display: block; padding: 10px 0; color: var(--ink); text-decoration: none; border-bottom: 3px solid transparent; }
  .nav li a:hover, .nav li a[aria-current="page"] { border-bottom-color: var(--ink); }
  @media (min-width: 768px) {
    .strip-links { display: flex; }
    .search { flex: 0 1 420px; }
    .menu { display: none; }
    .nav ul { display: flex; flex-direction: row; gap: var(--space-8); }
    .nav li a { padding: 12px 0; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.masthead .menu');
  const list = document.getElementById('primary-nav');
  btn?.addEventListener('click', () => {
    const open = list?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>
