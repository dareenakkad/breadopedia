---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="crumb t-nav" aria-label="Breadcrumb">
  {items.map((it, i) => (
    <>
      {i > 0 && <span class="sep" aria-hidden="true">›</span>}
      {it.href ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}
    </>
  ))}
</nav>
<style>
  .crumb { display: flex; flex-wrap: wrap; gap: var(--space-2); color: var(--ink); }
  .sep { color: var(--slate); }
</style>
